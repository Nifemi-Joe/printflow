{
  "extends": "../../tsconfig.base.json",
  "ts-node": {
    "compilerOptions": {
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true
    }
  },
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "exactOptionalPropertyTypes": false,
    "types": ["node"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
  },
  "include": ["src", "test", "scripts", "../../packages/*/src"],
  "exclude": ["dist", "node_modules"]
}
